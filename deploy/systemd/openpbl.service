[Unit]
Description=CoTeach production server (port 3000)
Wants=network-online.target openpbl-code-runner.service openpbl-survey-nlp.service openpbl-speech-alignment.service openpbl-outbound-proxy.service
After=network-online.target openpbl-code-runner.service openpbl-survey-nlp.service openpbl-speech-alignment.service openpbl-outbound-proxy.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/lkj/OpenPBL/openPBL
Environment=OPENPBL_PORT=3000
Environment=OPENPBL_HOSTNAME=127.0.0.1
Environment=OPENPBL_WEBSOCKET_PORT=3001
Environment=OPENPBL_WEBSOCKET_HOST=127.0.0.1
Environment=OPENPBL_CODE_RUNNER_PORT=3002
Environment=OPENPBL_SPEECH_ALIGNMENT_URL=http://127.0.0.1:3004
Environment=OPENPBL_PUBLIC_BASE_URL=https://coteach.cn
Environment=OPENPBL_OUTBOUND_PROXY=http://127.0.0.1:19999
Environment=OPENPBL_DEEPSEEK_PROXY=http://127.0.0.1:19999
Environment=OPENPBL_NAT64_PREFIXES=2001:67c:2960:6464::/96,2a00:1098:2c:0:0:5::/96,2a00:1098:2b:0:0:1::/96
# Only the explicitly managed egress/provider settings govern production.
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStartPre=/usr/bin/node /home/lkj/OpenPBL/openPBL/scripts/openpbl-nat64-proxy.mjs probe
ExecStart=/home/lkj/OpenPBL/openPBL/scripts/openpbl-production-service.sh run-app
Restart=always
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s
KillMode=control-group
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=default.target
