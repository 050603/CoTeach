// OpenPBL Prisma schema
// Replaces the single JSON file (.openpbl-data/session.json) with PostgreSQL.
//
// Design strategy (hybrid relational + JSONB):
// - Top-level frequently-queried entities get their own tables (Student, ClassroomSubmission,
//   LearningEvent, CompanionThread, CourseUpload, CourseSession, etc.) for indexing & queries.
// - Complex nested structures use JSONB columns on the parent table to avoid over-normalisation
//   (e.g. Course.content, Course.pblConfig, Course.uiState, CompanionThread.messages, GroupBoard.snapshot).
// - Every table has a `version` column for optimistic locking (compare-and-swap on update).

generator client {
  provider   = "prisma-client-js"
  // OpenPBL connects directly to PostgreSQL. Keep a local Node-API engine even
  // when the parent shell happens to define PRISMA_GENERATE_NO_ENGINE.
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Course — main aggregate root
// ============================================================================

model Course {
  id                            String  @id @default(uuid())
  name                          String
  subject                       String
  grade                         String
  hours                         Int
  summary                       String  @db.Text
  drivingQuestion               String  @db.Text
  learningObjectives            Json?
  expectedOutcome               String? @db.Text
  learnerProfile                Json?
  status                        String  @default("draft") // draft | preparing | ready | teaching | finished
  currentStageIndex             Int     @default(0)
  inviteCode                    String? @unique
  coverImageUrl                 String?
  presentingGroupId             String?
  presentingStudentId           String?
  classConfig                   Json?
  pblConfig                     Json?
  stageWorkspacePolicies        Json?
  // Canonical evidence workspace. Kept as bounded JSONB arrays because the
  // course aggregate is replaced atomically and these contracts evolve
  // together with the classroom workflow.
  learningEvidence              Json?
  artifactSnapshots             Json?
  aiContributions               Json?
  studentAiDecisions            Json?
  aiAssessmentSuggestions       Json?
  // Course content (single nested object) — kept as JSONB for flexibility.
  content                       Json?
  // Stages array — small bounded list, JSONB is sufficient.
  stages                        Json?
  // UI state — single nested object per course.
  uiState                       Json?
  // AI learning progress per student (keyed by studentId) — JSONB map.
  aiLearningProgress            Json?
  aiLearningClassroomId         String?
  teacherClassroomId            String?
  // Resolved intervention signal IDs — bounded set, JSONB.
  resolvedInterventionSignalIds Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  // Relations — one-to-many. Cascading deletes keep data consistent when a course is removed.
  students                     Student[]
  submissions                  ClassroomSubmission[]
  projectDocumentVersions      ProjectDocumentVersion[]
  projectPdfVersions           ProjectPdfVersion[]
  showcasePresentations        ShowcasePresentation[]
  aiInteractionEvents          AiInteractionEvent[]
  feedback                     TeacherFeedback[]
  rubricScores                 RubricScore[]
  reflections                  ReflectionRecord[]
  activityLog                  ActivityRecord[]
  announcements                CourseAnnouncement[]
  todos                        CourseTodo[]
  resources                    CourseResource[]
  groups                       ProjectGroup[]
  groupAnnouncements           GroupAnnouncement[]
  workPlan                     WorkPlanItem[]
  whiteboard                   WhiteboardNode[]
  boards                       GroupBoard[]
  uploads                      CourseUpload[]
  teamContributions            TeamContribution[]
  aiSupports                   AiSupportRecord[]
  teacherInterventions         TeacherIntervention[]
  stageTransitions             StageTransitionRecord[]
  evaluations                  EvaluationRecord[]
  learningEvents               LearningEvent[]
  companionThreads             CompanionThread[]
  companionTasks               CompanionTask[]
  companionConfirmations       CompanionConfirmation[]
  companionProcessRecords      CompanionProcessRecord[]
  learningSignals              LearningSignal[]
  classCommonIssues            ClassCommonIssue[]
  teacherAgentDirectives       TeacherAgentDirective[]
  offlineInterventions         OfflineInterventionRecord[]
  dynamicFacilitationScaffolds DynamicFacilitationScaffold[]
  sessions                     CourseSession[]
  groupMembers                 GroupMember[]
  todoCompletions              TodoCompletion[]
  announcementReplies          AnnouncementReply[]
  resourceDownloads            ResourceDownload[]
  generationJob                CourseGenerationJob?
  designGenerationJob          CourseDesignGenerationJob?
  offerings                    CourseOffering[]
  classroomTemplates           ClassroomTemplate[]
  classroomInstances           ClassroomInstance[]
  classroomSourceInstances     ClassroomInstance[]           @relation("ClassroomInstanceLegacySourceCourse")

  @@index([status])
  @@index([updatedAt])
}

// Durable, idempotent course-generation state. There is intentionally only
// one row per course so revisiting the page resumes the existing job.
model CourseGenerationJob {
  id                        String                           @id @default(uuid())
  courseId                  String                           @unique
  course                    Course                           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestedBy               String?
  status                    String                           @default("queued") // queued | running | cancelling | cancelled | completed | failed
  step                      String                           @default("queued")
  progress                  Int                              @default(0)
  message                   String                           @default("课程生成任务已创建") @db.Text
  scenesGenerated           Int                              @default(0)
  totalScenes               Int                              @default(0)
  estimatedRemainingSeconds Int?
  request                   Json
  preparedOutlines          Json?
  result                    Json?
  events                    Json                             @default("[]")
  error                     String?                          @db.Text
  attempt                   Int                              @default(0)
  startedAt                 DateTime?
  completedAt               DateTime?
  lastHeartbeatAt           DateTime?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  version                   Int                              @default(1)
  pageCheckpoints           CourseGenerationPageCheckpoint[]

  @@index([status, createdAt])
  @@index([lastHeartbeatAt])
}

// Durable page-level checkpoints. A page is reusable only when its canonical
// outline fingerprint still matches; restored pages still pass the whole-course
// audit before the classroom is persisted.
model CourseGenerationPageCheckpoint {
  id                 String              @id @default(uuid())
  jobId              String
  job                CourseGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pageKey            String
  outlineFingerprint String
  outlineOrder       Int
  scene              Json
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([jobId, pageKey])
  @@index([jobId, outlineOrder])
}

// Durable quick-design pipeline. It produces the same CourseContent fields as
// the detailed editor and then hands the course to CourseGenerationJob.
model CourseDesignGenerationJob {
  id                        String    @id @default(uuid())
  courseId                  String    @unique
  course                    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestedBy               String?
  status                    String    @default("queued") // queued | running | review_available | paused | cancelling | cancelled | completed | failed
  step                      String    @default("queued")
  reviewStatus              String    @default("unavailable") // unavailable | available | paused | approved | auto-continued
  reviewAvailableUntil      DateTime?
  stepIndex                 Int       @default(0)
  progress                  Int       @default(0)
  message                   String    @default("快速生成任务已创建") @db.Text
  estimatedRemainingSeconds Int?
  request                   Json
  trace                     Json      @default("[]")
  qualityReport             Json?
  error                     String?   @db.Text
  attempt                   Int       @default(0)
  startedAt                 DateTime?
  completedAt               DateTime?
  lastHeartbeatAt           DateTime?
  retryAt                   DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  version                   Int       @default(1)

  @@index([status, createdAt])
  @@index([status, retryAt])
  @@index([lastHeartbeatAt])
}

// ============================================================================
// CourseSession — archived historical teaching session (for restart teaching feature)
// ============================================================================

model CourseSession {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  inviteCode      String
  startedAt       DateTime
  endedAt         DateTime
  archivedData    Json // Full snapshot of classroom data at archive time (JSONB)
  studentCount    Int      @default(0)
  submissionCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([courseId, startedAt])
}

// ============================================================================
// Student — course enrolment
// ============================================================================

model Student {
  id         String   @id // matches Student.id in domain types (student-generated UUID)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name       String
  lastSeenAt String?
  // Snapshot of student-specific progress data (per-stage progress map).
  progress   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId])
}

// ============================================================================
// Classroom submissions, feedback, rubric scores, reflections, activity log
// ============================================================================

model ClassroomSubmission {
  id              String   @id
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  studentName     String
  participationId String?
  stageKey        String
  groupId         String?
  payload         Json // Flexible submission payload
  status          String   @default("draft")
  submittedAt     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  documentVersions ProjectDocumentVersion[]
  participation    ClassroomParticipation?  @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId])
  @@index([courseId, stageKey])
  @@index([participationId, createdAt])
}

// Immutable snapshots created when a student explicitly submits the project
// practice document. The mutable ClassroomSubmission remains the live draft.
model ProjectDocumentVersion {
  id              String              @id @default(uuid())
  courseId        String
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissionId    String
  submission      ClassroomSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  stageKey        String
  sequence        Int
  sourceVersion   Int
  title           String
  sourceHtml      String              @db.Text
  docxUploadId    String?
  docxSha256      String?
  docxSize        Int?
  status          String              @default("processing") // processing | submitted | failed
  error           String?             @db.Text
  requestId       String?
  submittedAt     DateTime?
  createdAt       DateTime            @default(now())

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([submissionId, sequence])
  @@unique([submissionId, requestId])
  @@index([courseId, studentId, stageKey, createdAt])
  @@index([submissionId, status])
  @@index([participationId, createdAt])
}

// Immutable snapshots created when a student explicitly submits an additional
// project outcome. Historical rows are PDFs; `kind` and `mimeType` allow the
// same durable collection to hold code, archives, and other supporting files.
model ProjectPdfVersion {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  groupId         String?
  stageKey        String
  sequence        Int
  title           String
  uploadId        String
  kind            String   @default("pdf") // pdf | file
  mimeType        String   @default("application/pdf")
  sha256          String?
  size            Int?
  status          String   @default("submitted") // submitted | failed
  requestId       String?
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentId, sequence])
  @@unique([courseId, requestId])
  @@index([courseId, studentId, stageKey, createdAt])
  @@index([uploadId])
  @@index([participationId, createdAt])
}

// One row is created for each student presentation request. Keeping this
// separate from Course.uiState prevents high-frequency scroll updates from
// rewriting the whole course aggregate and preserves an auditable lifecycle.
model ShowcasePresentation {
  id                String    @id @default(uuid())
  courseId          String
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId           String
  studentId         String
  participationId   String?
  artifactKind      String // document | pdf (generic files are download-only)
  artifactVersionId String
  artifactTitle     String
  displayMode       String    @default("continuous") // continuous | slides
  status            String    @default("pending") // pending | active | rejected | evaluating | ended | cancelled
  viewState         Json?
  revision          Int       @default(0)
  requestId         String?
  rejectionReason   String?   @db.Text
  requestedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  startedAt         DateTime?
  endedAt           DateTime?
  evaluationNote    String?   @db.Text
  evaluatedAt       DateTime?
  evaluatedBy       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, requestId])
  @@index([courseId, status, updatedAt])
  @@index([courseId, studentId, status])
  @@index([participationId, updatedAt])
}

model TeacherFeedback {
  id         String   @id
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String?
  groupId    String?
  stageKey   String?
  content    String   @db.Text
  authorName String
  payload    Json? // Domain-specific fields (targetType, targetId, kind, sourceRole, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, studentId])
}

model RubricScore {
  id        String   @id
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  groupId   String?
  stageKey  String?
  criteria  Json
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, studentId])
}

model ReflectionRecord {
  id              String   @id
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  studentName     String
  stageKey        String
  content         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId])
  @@index([participationId, createdAt])
}

model ActivityRecord {
  id         String   @id
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actor      String
  action     String
  detail     String?  @db.Text
  stageKey   String?
  occurredAt DateTime @default(now())
  payload    Json? // Extra domain metadata
  version    Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, occurredAt])
}

// ============================================================================
// Announcements, todos, resources
// ============================================================================

model CourseAnnouncement {
  id                String              @id
  courseId          String
  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  content           String              @db.Text
  pinned            Boolean             @default(false)
  replies           Json                @default("[]") // AnnouncementReply[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  version           Int                 @default(1)
  normalizedReplies AnnouncementReply[]

  @@unique([courseId, id])
  @@index([courseId, createdAt])
}

model CourseTodo {
  id          String           @id
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?          @db.Text
  stageKey    String?
  completedBy Json             @default("[]") // string[] of studentIds
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     Int              @default(1)
  completions TodoCompletion[]

  @@unique([courseId, id])
  @@index([courseId])
}

model CourseResource {
  id           String             @id
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  type         String
  size         String
  description  String?            @db.Text
  stageKey     String?
  url          String?
  previewUrl   String?
  previewType  String?
  displayMode  String? // document | slides
  downloadedBy Json               @default("[]") // string[] of studentIds
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  version      Int                @default(1)
  downloads    ResourceDownload[]

  @@unique([courseId, id])
  @@index([courseId])
  @@index([courseId, stageKey])
}

// ============================================================================
// Project groups, group announcements, work plan, whiteboard, group boards
// ============================================================================

model ProjectGroup {
  id                String        @id
  courseId          String
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name              String
  topic             String
  goal              String?       @db.Text
  keywords          Json          @default("[]") // string[]
  selectedForms     Json          @default("[]") // string[]
  members           Json          @default("[]") // GroupMemberRole[]
  proposal          Json? // ProjectProposal
  teacherApproval   Json? // { status, teacherName?, note?, updatedAt }
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  version           Int           @default(1)
  normalizedMembers GroupMember[]

  @@unique([courseId, id])
  @@index([courseId])
}

model GroupMember {
  id          String       @id @default(uuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId     String
  group       ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId   String
  studentName String
  role        String?
  joinedAt    DateTime     @default(now())

  @@unique([courseId, groupId, studentId])
  @@index([courseId, studentId])
}

model TodoCompletion {
  id          String     @id @default(uuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  todoId      String
  todo        CourseTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  studentId   String
  completedAt DateTime   @default(now())

  @@unique([courseId, todoId, studentId])
  @@index([courseId, studentId])
}

model AnnouncementReply {
  id             String             @id
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   CourseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  authorName     String
  content        String             @db.Text
  createdAt      DateTime           @default(now())

  @@unique([courseId, announcementId, id])
  @@index([courseId, announcementId, createdAt])
}

model ResourceDownload {
  id           String         @id @default(uuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId    String
  studentName  String
  downloadedAt DateTime       @default(now())

  @@unique([courseId, resourceId, studentId])
  @@index([courseId, studentId])
}

model CourseEvent {
  cursor        BigInt   @id @default(autoincrement())
  courseId      String
  requestId     String   @unique
  type          String
  actorId       String
  actorRole     String
  courseVersion Int
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([courseId, cursor])
  @@index([courseId, createdAt])
}

model CourseMutationReceipt {
  requestId     String    @id
  courseId      String
  status        String    @default("processing")
  courseVersion Int?
  eventCursor   BigInt?
  actorId       String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([courseId, createdAt])
}

model GroupAnnouncement {
  id        String   @id
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId   String
  title     String
  content   String   @db.Text
  actor     String
  createdAt DateTime @default(now())
  version   Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, groupId])
}

model WorkPlanItem {
  id         String   @id
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId    String
  role       String
  memberName String
  task       String   @db.Text
  progress   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, groupId])
}

model WhiteboardNode {
  id        String   @id
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId   String
  label     String
  note      String?  @db.Text
  x         Float
  y         Float
  color     String   @default("slate")
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, groupId])
}

model GroupBoard {
  groupId   String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  snapshot  Json // Opaque tldraw TLSnapshot
  mode      String   @default("mindmap") // mindmap | whiteboard
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@id([courseId, groupId])
  @@index([courseId])
}

model CourseUpload {
  id              String   @id
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId         String?
  studentId       String?
  participationId String?
  studentName     String?
  stageKey        String
  category        String // artifact | evidence | presentation | resource
  title           String
  fileName        String
  fileType        String
  size            String
  url             String
  createdAt       DateTime @default(now())
  version         Int      @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId])
  @@index([courseId, stageKey])
  @@index([participationId, createdAt])
}

model TeamContribution {
  id          String   @id
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId     String
  studentId   String?
  studentName String
  percent     Int
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, groupId])
}

// ============================================================================
// AI support records, teacher interventions, learning signals, common issues
// ============================================================================

model AiSupportRecord {
  id                String   @id
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stageKey          String
  targetType        String // student | group | course
  targetId          String
  groupId           String?
  studentId         String?
  participationId   String?
  studentName       String?
  kind              String
  trigger           String   @db.Text
  inputSummary      String   @db.Text
  diagnosis         String   @db.Text
  suggestions       Json     @default("[]") // string[]
  evidence          Json     @default("[]") // string[]
  status            String   @default("draft")
  source            String? // llm | local
  editedContent     String?  @db.Text
  structuredPayload Json?
  adoption          Json? // { decision, reason?, before?, after?, handledBy, handledAt }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, targetId])
  @@index([courseId, stageKey])
  @@index([participationId, createdAt])
}

model TeacherIntervention {
  id        String   @id
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String?
  groupId   String?
  stageKey  String?
  kind      String
  content   String   @db.Text
  createdBy String
  payload   Json? // Domain-specific fields (scope, targetIds, reason, evidence, action, instruction, severity, status, signalId, resolvedAt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, studentId])
}

model LearningSignal {
  id                     String    @id
  courseId               String
  course                 Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId              String
  stageKey               String
  sceneId                String?
  kind                   String
  severity               String // notice | warning | high
  status                 String    @default("open") // open | handled | resolved | dismissed
  title                  String
  summary                String    @db.Text
  content                Json?
  normalizedIssueKey     String
  evidenceEventIds       Json      @default("[]") // string[]
  aiInterventionAttempts Int       @default(0)
  firstDetectedAt        DateTime
  lastDetectedAt         DateTime
  handledAt              DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  version                Int       @default(1)

  @@unique([courseId, id])
  @@index([courseId, studentId, status])
}

model ClassCommonIssue {
  id                 String    @id
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stageKey           String
  kind               String
  title              String
  summary            String    @db.Text
  affectedStudentIds Json      @default("[]") // string[]
  thresholdMetAt     DateTime
  resolvedAt         DateTime?
  payload            Json? // Domain-specific fields (normalizedIssueKey, content, severity, signalIds, affectedStudents, status, lastDetectedAt, handledAt)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  @@unique([courseId, id])
  @@index([courseId, stageKey])
}

model TeacherAgentDirective {
  id          String   @id
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scope       String // student | group | class
  targetId    String?
  stageKey    String?
  goal        String   @db.Text
  content     String?  @db.Text // Domain `instruction` field
  constraints Json?
  issuedBy    String
  payload     Json? // Domain-specific fields (targetStudentIds, targetScope, instruction, successCriteria, status, completedAt, revokedAt)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, scope, targetId])
}

model OfflineInterventionRecord {
  id          String   @id
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   String?
  stageKey    String?
  kind        String // patrol | tutoring | whole-class
  content     String   @db.Text
  teacherName String
  occurredAt  DateTime
  payload     Json? // Domain-specific fields (targetStudentIds, signalIds, note)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, occurredAt])
}

model DynamicFacilitationScaffold {
  id        String   @id
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stageKey  String
  framework Json // Scaffold framework data
  evidence  Json     @default("[]") // supporting evidence references
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, stageKey])
}

// ============================================================================
// Stage transitions, evaluations, learning events
// ============================================================================

model StageTransitionRecord {
  id             String   @id
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fromStageKey   String
  toStageKey     String
  gateStatus     String // passed | overridden
  blockers       Json     @default("[]") // string[]
  warnings       Json     @default("[]") // string[]
  overrideReason String?  @db.Text
  actor          String
  createdAt      DateTime @default(now())
  version        Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, createdAt])
}

model EvaluationRecord {
  id        String   @id
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String?
  groupId   String?
  stageKey  String?
  kind      String
  result    Json
  content   String?  @db.Text
  payload   Json? // Domain-specific fields (sourceRole, targetType, targetId, score, evidence, status)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([courseId, id])
  @@index([courseId, studentId])
}

model LearningEvent {
  id                        String   @id
  idempotencyKey            String
  courseId                  String
  course                    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId                 String
  stageKey                  String
  sceneId                   String?
  type                      String
  occurredAt                DateTime
  durationMs                Int?
  expectedDurationSec       Int?
  ttsDurationSec            Int?
  plannedStudentActivitySec Int?
  visible                   Boolean?
  progressMarker            String?
  content                   Json? // LearningContentReference
  metadata                  Json?
  createdAt                 DateTime @default(now())
  version                   Int      @default(1)
  // Long-lived course-platform context. These fields are optional so the
  // existing classroom event writer remains backwards compatible while new
  // events are attached to an offering/activity instance.
  offeringId                String?
  enrollmentId              String?
  chapterId                 String?
  activityId                String?
  classroomInstanceId       String?
  participationId           String?
  eventVersion              Int      @default(1)
  receivedAt                DateTime @default(now())
  source                    String   @default("classroom")

  offering          CourseOffering?         @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  enrollment        Enrollment?             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  chapter           Chapter?                @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  activity          Activity?               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  classroomInstance ClassroomInstance?      @relation(fields: [classroomInstanceId], references: [id], onDelete: Restrict)
  participation     ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@unique([courseId, idempotencyKey])
  @@index([courseId, studentId, occurredAt])
  @@index([courseId, type])
  @@index([offeringId, enrollmentId, occurredAt])
  @@index([offeringId, activityId, occurredAt])
}

// ============================================================================
// Companion threads, tasks, confirmations, process records
// ============================================================================

model CompanionThread {
  id              String   @id
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  stageKey        String
  messages        Json     @default("[]") // CompanionMessage[]
  openingSentAt   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId, stageKey])
  @@index([participationId, createdAt])
}

model CompanionTask {
  id              String   @id
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  stageKey        String
  companionId     String?
  kind            String
  title           String
  request         String   @db.Text
  status          String   @default("queued")
  result          String?  @db.Text
  error           String?  @db.Text
  confirmationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId, status])
  @@index([participationId, createdAt])
}

model CompanionConfirmation {
  id              String    @id
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  stageKey        String
  action          String
  title           String
  summary         String    @db.Text
  taskId          String?
  payload         Json?
  status          String    @default("pending") // pending | confirmed | rejected
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  version         Int       @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId, status])
  @@index([participationId, createdAt])
}

model CompanionProcessRecord {
  id              String   @id
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  stageKey        String
  title           String
  summary         String   @db.Text
  source          String // student | agent | system
  companionId     String?
  taskId          String?
  evidenceIds     Json     @default("[]") // string[]
  createdAt       DateTime @default(now())
  version         Int      @default(1)

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([courseId, id])
  @@index([courseId, studentId, createdAt])
  @@index([participationId, createdAt])
}

// Append-only audit trail for every student ↔ AI collaboration event. The
// existing CompanionThread JSON remains the model/UI context; this table is
// the canonical source for teacher monitoring and analysis exports.
model AiInteractionEvent {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  participationId String?
  stageKey        String
  conversationId  String?
  source          String // sidebar | selection | proactive-comment | submission | system
  eventType       String // request | response | policy | proposal | decision | undo | comment | submit | error
  actorRole       String // student | ai | system | teacher
  actorId         String?
  content         String?  @db.Text
  payload         Json     @default("{}")
  requestId       String?
  createdAt       DateTime @default(now())

  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([courseId, studentId, stageKey, createdAt])
  @@index([courseId, requestId])
  @@index([courseId, source, createdAt])
  @@index([participationId, createdAt])
}

// ============================================================================
// SessionMeta — global session state (joinedCourseId etc.)
// ============================================================================

model SessionMeta {
  id             String   @id @default("singleton")
  joinedCourseId String?
  userRole       String?
  userName       String?
  studentId      String?
  studentName    String?
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)
}

// ============================================================================
// UploadFile — file metadata for upload management & cleanup (Stage 6)
// ============================================================================

model UploadFile {
  id                String    @id @default(uuid())
  fileName          String
  storedName        String
  courseId          String?
  uploadedById      String
  uploadedByRole    String
  size              Int
  mimeType          String
  previewStoredName String?   @unique
  previewMimeType   String?
  previewSize       Int?
  referencedBy      Json      @default("[]") // string[] of upload IDs referencing this file
  refCount          Int       @default(0)
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  @@unique([storedName])
  @@index([courseId])
  @@index([uploadedById])
  @@index([refCount])
}

// ============================================================================
// Teacher & StudentAccount — authentication (Stage 2)
// ============================================================================

model Teacher {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String
  displayName    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  sessionVersion Int       @default(1)

  @@index([username])
}

model StudentAccount {
  id             String    @id @default(uuid())
  courseId       String
  studentId      String // matches Student.id in domain types
  studentName    String
  nameKey        String
  inviteCode     String // invite code used to join (for re-join detection)
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?
  sessionVersion Int       @default(1)

  @@unique([courseId, studentId])
  @@unique([courseId, nameKey])
  @@index([courseId])
  @@index([inviteCode])
}

// ============================================================================
// Long-lived course platform
// ============================================================================

/// Unified identity used by the course platform. Legacy Teacher and
/// StudentAccount rows remain during the transition; platform routes create a
/// matching User row for existing teachers when they first use the new APIs.
model User {
  id             String    @id @default(uuid())
  username       String    @unique
  usernameKey    String    @unique
  displayName    String
  passwordHash   String
  role           String // student | teacher
  status         String    @default("active") // active | suspended | disabled
  sessionVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  offerings             CourseOffering[]      @relation("OfferingTeacher")
  classroomTemplates    ClassroomTemplate[]
  enrollments           Enrollment[]
  passwordResetTargets  PasswordResetToken[]  @relation("PasswordResetTarget")
  passwordResetRequests PasswordResetToken[]  @relation("PasswordResetIssuer")
  learningEventRecords  LearningEventRecord[]

  @@index([role, status])
}

model PasswordResetToken {
  id            String    @id @default(uuid())
  targetUserId  String
  requestedById String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  targetUser  User @relation("PasswordResetTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedBy User @relation("PasswordResetIssuer", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([targetUserId, expiresAt])
  @@index([requestedById, createdAt])
}

model CourseOffering {
  id             String    @id @default(uuid())
  teacherId      String
  legacyCourseId String?
  name           String
  description    String?   @db.Text
  term           String?
  startsAt       DateTime?
  endsAt         DateTime?
  status         String    @default("draft") // draft | open | finished | archived
  coverImageUrl  String?
  plan           Json?
  settings       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  teacher              User                     @relation("OfferingTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  legacyCourse         Course?                  @relation(fields: [legacyCourseId], references: [id], onDelete: SetNull)
  invitation           CourseInvitation?
  enrollments          Enrollment[]
  chapters             Chapter[]
  activities           Activity[]
  instances            ClassroomInstance[]
  participations       ClassroomParticipation[]
  activityProgress     ActivityProgress[]
  events               LearningEvent[]
  learningEventRecords LearningEventRecord[]

  @@index([teacherId, status, updatedAt])
  @@index([status, startsAt])
}

model CourseInvitation {
  id         String    @id @default(uuid())
  offeringId String    @unique
  code       String    @unique
  expiresAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([code, disabledAt, expiresAt])
}

model Enrollment {
  id                String    @id @default(uuid())
  userId            String
  offeringId        String
  status            String    @default("active") // active | withdrawn | completed
  joinedAt          DateTime  @default(now())
  withdrawnAt       DateTime?
  currentChapterId  String?
  currentActivityId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  user                 User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  offering             CourseOffering           @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  progress             ActivityProgress[]
  participations       ClassroomParticipation[]
  events               LearningEvent[]
  learningEventRecords LearningEventRecord[]

  @@unique([userId, offeringId])
  @@unique([id, offeringId])
  @@index([offeringId, status, joinedAt])
}

model Chapter {
  id          String    @id @default(uuid())
  offeringId  String
  title       String
  description String?   @db.Text
  position    Int
  isOpen      Boolean   @default(false)
  opensAt     DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  offering             CourseOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  activities           Activity[]
  events               LearningEvent[]
  learningEventRecords LearningEventRecord[]

  @@unique([offeringId, position])
  @@unique([id, offeringId])
  @@index([offeringId, archivedAt, position])
}

model Activity {
  id          String    @id @default(uuid())
  offeringId  String
  chapterId   String
  type        String // Classroom | Assignment | Quiz | Form | Resource
  title       String
  description String?   @db.Text
  position    Int
  isOpen      Boolean   @default(false)
  opensAt     DateTime?
  config      Json?
  archivedAt  DateTime?
  templateId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  // The chapter and activity must come from the same offering. The composite
  // relation keeps a caller from attaching an activity to a chapter in a
  // different teaching class even when both records have valid IDs.
  chapter              Chapter               @relation(fields: [chapterId, offeringId], references: [id, offeringId], onDelete: Restrict)
  offering             CourseOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  progress             ActivityProgress[]
  template             ClassroomTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  instances            ClassroomInstance[]
  events               LearningEvent[]
  learningEventRecords LearningEventRecord[]

  @@unique([chapterId, position])
  @@unique([id, offeringId])
  @@index([offeringId, chapterId, archivedAt, position])
}

model ClassroomTemplate {
  id             String   @id @default(uuid())
  teacherId      String
  legacyCourseId String?
  title          String
  description    String?  @db.Text
  status         String   @default("draft") // draft | ready | archived
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  teacher       User                       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  legacyCourse  Course?                    @relation(fields: [legacyCourseId], references: [id], onDelete: SetNull)
  activityLinks Activity[]
  versions      ClassroomTemplateVersion[]

  @@index([teacherId, status, updatedAt])
  @@index([legacyCourseId])
}

model ClassroomTemplateVersion {
  id         String   @id @default(uuid())
  templateId String
  version    Int
  status     String   @default("ready") // draft | ready | archived
  snapshot   Json
  mediaRefs  Json?
  createdAt  DateTime @default(now())

  template  ClassroomTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  instances ClassroomInstance[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model ClassroomInstance {
  id                   String    @id @default(uuid())
  offeringId           String
  activityId           String
  templateVersionId    String
  legacyCourseId       String?
  legacySourceCourseId String?
  status               String    @default("scheduled") // scheduled | teaching | finished | archived
  snapshot             Json
  startedAt            DateTime?
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  version              Int       @default(1)

  offering             CourseOffering           @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  activity             Activity                 @relation(fields: [activityId, offeringId], references: [id, offeringId], onDelete: Restrict)
  templateVersion      ClassroomTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  legacyCourse         Course?                  @relation(fields: [legacyCourseId], references: [id], onDelete: SetNull)
  legacySourceCourse   Course?                  @relation("ClassroomInstanceLegacySourceCourse", fields: [legacySourceCourseId], references: [id], onDelete: SetNull)
  participations       ClassroomParticipation[]
  events               LearningEvent[]
  learningEventRecords LearningEventRecord[]

  @@unique([id, offeringId])
  @@index([offeringId, activityId, status])
  @@index([templateVersionId])
  @@index([legacyCourseId])
  @@index([legacySourceCourseId])
}

model ClassroomParticipation {
  id             String    @id @default(uuid())
  offeringId     String
  instanceId     String
  enrollmentId   String
  firstEnteredAt DateTime  @default(now())
  lastEnteredAt  DateTime  @default(now())
  stageProgress  Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  instance                ClassroomInstance        @relation(fields: [instanceId, offeringId], references: [id, offeringId], onDelete: Restrict)
  enrollment              Enrollment               @relation(fields: [enrollmentId, offeringId], references: [id, offeringId], onDelete: Restrict)
  offering                CourseOffering           @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  events                  LearningEvent[]
  learningEventRecords    LearningEventRecord[]
  projectWorkspace        StudentProjectWorkspace?
  submissions             ClassroomSubmission[]
  documentVersions        ProjectDocumentVersion[]
  pdfVersions             ProjectPdfVersion[]
  reflections             ReflectionRecord[]
  uploads                 CourseUpload[]
  aiSupports              AiSupportRecord[]
  companionThreads        CompanionThread[]
  companionTasks          CompanionTask[]
  companionConfirmations  CompanionConfirmation[]
  companionProcessRecords CompanionProcessRecord[]
  aiInteractionEvents     AiInteractionEvent[]
  showcasePresentations   ShowcasePresentation[]

  @@unique([instanceId, enrollmentId])
  @@index([offeringId, enrollmentId, completedAt])
}

/// A student's project workspace belongs to one concrete classroom
/// participation. It intentionally does not use ProjectGroup, which is a
/// legacy collaborative structure and cannot represent an individual's
/// long-lived project safely across repeated classroom runs.
model StudentProjectWorkspace {
  id              String   @id @default(uuid())
  participationId String   @unique
  status          String   @default("active") // active | read_only | archived
  projectState    Json?
  aiMembers       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
}

model ActivityProgress {
  id             String    @id @default(uuid())
  offeringId     String
  enrollmentId   String
  activityId     String
  status         String    @default("not_started") // not_started | in_progress | completed
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  enrollment Enrollment     @relation(fields: [enrollmentId, offeringId], references: [id, offeringId], onDelete: Restrict)
  activity   Activity       @relation(fields: [activityId, offeringId], references: [id, offeringId], onDelete: Restrict)
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, activityId])
  @@index([offeringId, enrollmentId, status])
}

/// Append-only event log for the long-lived course platform. It deliberately
/// does not reuse the legacy Course aggregate's event array, so event history
/// remains complete when classroom state is updated or a class is taught again.
model LearningEventRecord {
  id                  String   @id @default(uuid())
  idempotencyKey      String
  userId              String
  offeringId          String
  enrollmentId        String?
  chapterId           String?
  activityId          String?
  classroomInstanceId String?
  participationId     String?
  type                String
  occurredAt          DateTime
  receivedAt          DateTime @default(now())
  source              String   @default("platform")
  metadata            Json?
  eventVersion        Int      @default(1)

  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  offering          CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  enrollment        Enrollment?             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  chapter           Chapter?                @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  activity          Activity?               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  classroomInstance ClassroomInstance?      @relation(fields: [classroomInstanceId], references: [id], onDelete: Restrict)
  participation     ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([userId, offeringId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([offeringId, activityId, occurredAt])
  @@index([offeringId, enrollmentId, occurredAt])
}

model ProviderCredential {
  section         String
  providerId      String
  encryptedApiKey Bytes?
  iv              Bytes?
  authTag         Bytes?
  config          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  @@id([section, providerId])
  @@index([updatedAt])
}

model LoadTestRun {
  runId        String   @id
  teacherId    String   @unique
  courseId     String   @unique
  studentCount Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}
