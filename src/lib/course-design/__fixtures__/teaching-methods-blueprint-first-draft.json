{
  "section": {
    "title": "支架式与抛锚式教学法",
    "learningObjective": "学生能够区分支架式与抛锚式的异同，并能选择一种方法设计一节AI教学的初步环节。",
    "sharedContext": {
      "learningPurpose": "掌握两种重要教学方法，理解支架的临时性与渐消性，以及抛锚式如何基于真实情境展开探究。",
      "stableTerms": [
        "支架式教学法",
        "抛锚式教学法",
        "最近发展区",
        "锚点"
      ],
      "conceptBoundaries": [
        "支架式强调教师提供临时支架，逐渐撤除；抛锚式强调真实“锚”问题驱动。",
        "支架式适合技能习得初期，抛锚式适合综合应用阶段。"
      ]
    },
    "units": [
